{
  "name": "@refhub/cli",
  "version": "1.4.0",
  "description": "refhub CLI execution layer for agent skills",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/refhub-io/refhub-cli"
  },
  "homepage": "https://github.com/refhub-io/refhub-cli#readme",
  "bugs": {
    "url": "https://github.com/refhub-io/refhub-cli/issues"
  },
  "engines": { "node": ">=18" },
  "bin": { "refhub": "bin/refhub.js" },
  "scripts": {
    "build": "tsc",
